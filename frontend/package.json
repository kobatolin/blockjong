{
  "name": "blockjong-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "dev:sandbox": "node -r ../scripts/sandbox-preload.cjs node_modules/vite/bin/vite.js",
    "build:sandbox": "node -r ../scripts/sandbox-preload.cjs node_modules/vite/bin/vite.js build",
    "test:sandbox": "node -r ../scripts/sandbox-preload.cjs node_modules/vitest/vitest.mjs run --pool=threads"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
